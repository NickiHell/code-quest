# Пример переменных для docker-compose (см. также корневой .env.example).

APP_ENV=development
SECRET_KEY=changeme-in-prod
LOG_LEVEL=INFO
# Каталог для app.log с ротацией 100 МБ; пусто — только вывод в консоль
LOG_DIR=logs

# DATABASE
POSTGRES_USER=codequest
POSTGRES_PASSWORD=codequest
POSTGRES_DB=codequest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# TELEGRAM
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBAPP_URL=https://your-domain.com/miniapp/
PUBLIC_BASE_URL=https://your-domain.com
ADMIN_API_KEY=change-me-min-16-chars-long

# ИИ — yandex_openai_responses | openai_compatible | yandex_gpt | yandex_ai_studio_agent | ollama
AI_BACKEND=yandex_openai_responses
AI_TIMEOUT=60

# Yandex Cloud (gpt://... URI)
YANDEX_FOLDER_ID=b1g...
YANDEX_AUTH=<API-ключ или IAM-токен>
YANDEX_OPENAI_MODEL=gpt://b1g.../yandexgpt-5-lite/latest
# YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1  # дефолт

# Generic OpenAI-compatible (Groq, Together AI, Mistral, Deepseek, OpenAI…)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# SANDBOX
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
