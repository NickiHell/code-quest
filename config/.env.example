# Пример переменных для docker-compose (см. также корневой .env.example).

APP_ENV=development
SECRET_KEY=changeme-in-prod
LOG_LEVEL=INFO

# DATABASE
POSTGRES_USER=codequest
POSTGRES_PASSWORD=codequest
POSTGRES_DB=codequest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# TELEGRAM
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBAPP_URL=https://your-domain.com/miniapp/
PUBLIC_BASE_URL=https://your-domain.com
ADMIN_API_KEY=change-me-min-16-chars-long

# ИИ — см. корневой .env.example (ollama | yandex_gpt | yandex_ai_studio_agent | yandex_openai_responses)
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen2.5-coder:14b
AI_TIMEOUT=30
# YANDEX_FOLDER_ID=
# YANDEX_AUTH=
# YANDEX_ASSISTANT_ID=
# YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# YANDEX_OPENAI_MODEL=aliceai-llm/latest

# SANDBOX
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
