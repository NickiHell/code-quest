# Пример для локального Aider + Ollama (не читает приложение Code Quest — это только CLI).
# Скопируйте в shell или: set -a && source config/aider.env.example && set +a
#
# Документация: https://aider.chat/docs/llms/ollama.html

export OLLAMA_API_BASE=http://127.0.0.1:11434

# Рекомендуется префикс ollama_chat/ (не ollama/).
# Модель должна быть скачана: ollama pull qwen2.5-coder:14b
# Запуск из корня репозитория:
#   aider --model ollama_chat/qwen2.5-coder:14b
