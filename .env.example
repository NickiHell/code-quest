# APP
APP_ENV=development
# development/dev/local — в loguru для ошибок включается diagnose (значения переменных в стеке)
SECRET_KEY=changeme-in-prod
LOG_LEVEL=INFO

# DATABASE (asyncpg)
DATABASE_URL=postgresql+asyncpg://codequest:codequest@db:5432/codequest

# REDIS
REDIS_URL=redis://redis:6379/0

# TELEGRAM
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Полный HTTPS-URL страницы Mini App (должен совпадать с тем, что в BotFather / кнопке)
# Пример после деплоя: https://api.example.com/miniapp/
# Локально через ngrok: https://xxxx.ngrok-free.app/miniapp/
WEBAPP_URL=https://your-domain.com/miniapp/
# Тот же хост без пути — для ссылок на /admin/ и CORS
PUBLIC_BASE_URL=https://your-domain.com
# Секрет для GET /api/admin/stats и веб-админки (мин. 16 символов)
ADMIN_API_KEY=change-me-min-16-chars-long

# --- ИИ: несколько агентов ---
# AI_BACKEND — значение по умолчанию, если нет override в Redis.
# Можно задать креды сразу для Ollama и Yandex: в рантайме поднимутся все доступные провайдеры.
# Переключение без перезапуска: веб-админка /admin/ (раздел «Режим ИИ») или
# PUT /api/admin/ai-backend с заголовком X-Admin-Key (хранится ключ Redis codequest:ai_backend_override).

# Значения: ollama | yandex_gpt | yandex_ai_studio_agent | yandex_openai_responses
AI_BACKEND=ollama

# --- Ollama (локальная LLM) — нужны OLLAMA_BASE_URL + AI_MODEL
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen2.5-coder:14b
AI_TIMEOUT=30

# --- YandexGPT (Foundation Models через yandex-ai-studio-sdk) ---
# Нужны YANDEX_FOLDER_ID и YANDEX_AUTH; опционально модель:
# YANDEX_FOLDER_ID=b1g...
# YANDEX_AUTH=<API-ключ или IAM-токен>
YANDEX_GPT_MODEL_NAME=yandexgpt
YANDEX_GPT_MODEL_VERSION=latest
# Алиасы из доков Yandex: YANDEX_CLOUD_FOLDER, YANDEX_CLOUD_API_KEY подхватываются автоматически.

# --- Ассистент Yandex AI Studio (поток thread/run в SDK) ---
# Плюс к папке и auth: публичный ID ассистента
# YANDEX_ASSISTANT_ID=...

# --- Yandex OpenAI-compatible Responses API (AsyncOpenAI + project=folder) ---
# Нужны folder + auth; опционально YANDEX_CLOUD_MODEL как алиас к YANDEX_OPENAI_MODEL
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_OPENAI_MODEL=aliceai-llm/latest
YANDEX_OPENAI_TEMPERATURE=0.3
YANDEX_OPENAI_MAX_OUTPUT_TOKENS=4096

# SANDBOX (Docker SDK)
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
