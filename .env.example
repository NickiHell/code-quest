# APP
APP_ENV=development
SECRET_KEY=changeme-in-prod
LOG_LEVEL=INFO

# DATABASE (asyncpg)
DATABASE_URL=postgresql+asyncpg://codequest:codequest@db:5432/codequest

# REDIS
REDIS_URL=redis://redis:6379/0

# TELEGRAM
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBAPP_URL=https://your-domain.com/miniapp/
PUBLIC_BASE_URL=https://your-domain.com
ADMIN_API_KEY=change-me-min-16-chars-long

# ИИ — выбор бэкенда (переключение в рантайме через /admin/ или Redis)
# Значения: yandex_openai_responses | openai_compatible | yandex_gpt | yandex_ai_studio_agent | ollama
AI_BACKEND=yandex_openai_responses
AI_TIMEOUT=60

# --- Yandex Cloud: OpenAI-совместимый Responses API (рекомендуется) ---
# gpt://FOLDER_ID/MODEL/VERSION  — полный URI или просто имя модели
YANDEX_FOLDER_ID=b1g...
YANDEX_AUTH=<API-ключ или IAM-токен>
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_OPENAI_MODEL=gpt://b1g.../yandexgpt-5-lite/latest
YANDEX_OPENAI_TEMPERATURE=0.3
YANDEX_OPENAI_MAX_OUTPUT_TOKENS=4096
# Алиасы Yandex: YANDEX_CLOUD_FOLDER, YANDEX_CLOUD_API_KEY, YANDEX_CLOUD_MODEL — подхватываются автоматически

# --- Альтернатива: любой OpenAI-совместимый провайдер ---
# AI_BACKEND=openai_compatible
# OPENAI_COMPAT_API_KEY=<ключ>
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1    # пусто = OpenAI
# Провайдеры: OpenAI | Groq | Together AI | Mistral | Deepseek | любой OpenAI-compat

# --- YandexGPT через yandex-ai-studio-sdk (альтернатива) ---
# AI_BACKEND=yandex_gpt
# YANDEX_GPT_MODEL_NAME=yandexgpt
# YANDEX_GPT_MODEL_VERSION=latest

# --- Yandex AI Studio Agent (thread/run) ---
# AI_BACKEND=yandex_ai_studio_agent
# YANDEX_ASSISTANT_ID=...

# --- Ollama (локальные модели, опционально) ---
# AI_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5-coder:14b

# SANDBOX (Docker SDK)
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
