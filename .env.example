# APP
APP_ENV=development
SECRET_KEY=changeme-in-prod
LOG_LEVEL=INFO

# DATABASE: runtime (в docker-compose.dev — на db; в prod — на pgbouncer:5432)
DATABASE_URL=postgresql+asyncpg://codequest:codequest@db:5432/codequest

# Прямой Postgres для Alembic (минуя PgBouncer). В dev можно не задавать — будет как DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql+asyncpg://codequest:codequest@db:5432/codequest

# REDIS (/0 — приложение; Celery по умолчанию использует /1)
REDIS_URL=redis://redis:6379/0

# Опционально: явный брокер Celery
# CELERY_BROKER_URL=redis://redis:6379/1

# TELEGRAM (BOT_TOKEN нужен и для проверки подписи Mini App initData)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBAPP_URL=https://your-domain.com/miniapp/
PUBLIC_BASE_URL=https://your-domain.com

# Webhook: секрет в пути POST /webhook/telegram/{secret} (минимум 16 символов)
TELEGRAM_WEBHOOK_SECRET=change-me-16chars-minimum
# Для локалки без HTTPS у Telegram: false + туннель (cloudflared) и true на проде
TELEGRAM_SET_WEBHOOK_ON_STARTUP=true

# Mini App: макс. возраст auth_date (сек), 0 только для отладки
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Лимиты запросов на пользователя (в минуту), Redis
# RATE_LIMIT_QUIZ_NEXT_PER_MINUTE=10
# RATE_LIMIT_QUIZ_ANSWER_PER_MINUTE=60
# RATE_LIMIT_SUBMISSIONS_PER_MINUTE=15

# Yandex Cloud LLM — yandex_openai_responses | yandex_gpt | yandex_ai_studio_agent
AI_BACKEND=yandex_openai_responses
AI_TIMEOUT=60

# Responses API (рекомендуется)
YANDEX_FOLDER_ID=b1g...
YANDEX_AUTH=<API-ключ или IAM-токен>
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_OPENAI_MODEL=gpt://b1g.../yandexgpt-5-lite/latest
YANDEX_OPENAI_TEMPERATURE=0.3
YANDEX_OPENAI_MAX_OUTPUT_TOKENS=4096

# Алиасы: YANDEX_CLOUD_FOLDER, YANDEX_CLOUD_API_KEY, YANDEX_CLOUD_MODEL

# YandexGPT SDK: AI_BACKEND=yandex_gpt
# YANDEX_GPT_MODEL_NAME=yandexgpt
# YANDEX_GPT_MODEL_VERSION=latest

# AI Studio Agent: AI_BACKEND=yandex_ai_studio_agent
# YANDEX_ASSISTANT_ID=...

# SANDBOX (Docker SDK)
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
